{
  "name": "mail-triage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "node --env-file-if-exists=.env --import tsx evals/run.ts",
    "report": "node --import tsx evals/report.ts",
    "pipeline": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "gmail-auth": "node --env-file-if-exists=.env --import tsx scripts/gmail-auth.ts",
    "export-emails": "node --env-file-if-exists=.env --import tsx scripts/export-emails.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "googleapis": "^173.0.0",
    "openai": "^6.45.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
